{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "universal-toolbox",
  "version": "0.1.5",
  "identifier": "com.wwwwwhj.universal-toolbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "universal-toolbox",
        "width": 1600,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMDIyRDZERTJBQTBDN0MKUldSOERLcmliUzBDY0lxRzJnRjQveHhDVnZGUitvWWg1MDlhWXBnWFRDQ2h6OGhjSWFSUlU4N0UK",
      "endpoints": [
        "https://github.com/wwwwwhj/Universal-Toolbox/releases/latest/download/latest.json"
      ]
    }
  }
}
